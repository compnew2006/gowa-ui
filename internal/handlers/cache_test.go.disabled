		OrganizationID: org.ID,
		Name:           "Inactive Webhook",
		URL:            "https://example.com/inactive",
		Events:         models.StringArray{"test.event"},
		IsActive:       false,
	}
	require.NoError(t, app.DB.Create(inactiveWebhook).Error)

	// Should only return active webhook
