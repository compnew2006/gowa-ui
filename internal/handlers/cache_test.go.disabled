// TestApp_getWhatsAppAccountCached_NoRedis tests behavior when Redis is nil
func TestApp_getWhatsAppAccountCached_NoRedis(t *testing.T) {
	t.Parallel()

	db := testutil.SetupTestDB(t)
	log := testutil.NopLogger()
	cfg := &config.Config{
		App: config.AppConfig{
			EncryptionKey: "test-encryption-key",
		},
	}

	app := &handlers.App{
		Config: cfg,
		DB:     db,
		Log:    log,
		Redis:  nil, // No Redis
	}

	org := testutil.CreateTestOrganization(t, app.DB)

	// Create account
	encryptedToken, err := crypto.Encrypt("test-token", app.Config.App.EncryptionKey)
	require.NoError(t, err)

	account := &models.WhatsAppAccount{
		OrganizationID: org.ID,
		Name:           "test-account",
		PhoneID:        "phone123",
		BusinessID:     "business123",
		AccessToken:    encryptedToken,
	}
	require.NoError(t, app.DB.Create(account).Error)

	// Should still work without Redis
	result, err := app.GetWhatsAppAccountCached("phone123")
	require.NoError(t, err)
	assert.Equal(t, account.ID, result.ID)
	assert.Equal(t, "test-token", result.AccessToken)
}

