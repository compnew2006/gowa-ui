// TestApp_InvalidateRolePermissionsCache tests invalidating role permissions cache
func TestApp_InvalidateRolePermissionsCache(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	role := testutil.CreateTestRoleWithKeys(t, app.DB, org.ID, "test-role", []string{"users:read"})
	user1 := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))
	user2 := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))

	// Create cache entries
	roleCacheKey := "permissions:role:" + role.ID.String()
	user1CacheKey := "permissions:user:" + user1.ID.String()
	user2CacheKey := "permissions:user:" + user2.ID.String()

	err := app.Redis.Set(context.Background(), roleCacheKey, "role-data", 6*time.Hour).Err()
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), user1CacheKey, "user1-data", 6*time.Hour).Err()
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), user2CacheKey, "user2-data", 6*time.Hour).Err()
	require.NoError(t, err)

	// Invalidate
	app.InvalidateRolePermissionsCache(role.ID)

	// Verify all keys are deleted
	_, err = app.Redis.Get(context.Background(), roleCacheKey).Result()
	assert.Equal(t, redis.Nil, err)

	_, err = app.Redis.Get(context.Background(), user1CacheKey).Result()
	assert.Equal(t, redis.Nil, err)

	_, err = app.Redis.Get(context.Background(), user2CacheKey).Result()
	assert.Equal(t, redis.Nil, err)
}

