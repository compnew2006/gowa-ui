	require.NoError(t, err)
	assert.Len(t, result, 1)
	assert.Equal(t, activeWebhook.ID, result[0].ID)
}

// TestApp_getSLAEnabledSettingsCached_CacheHit tests retrieving SLA settings from cache
func TestApp_getSLAEnabledSettingsCached_CacheHit(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	// Create SLA-enabled settings
	settings1 := testutil.CreateTestChatbotSettings(t, app.DB, org.ID, "account1")
	settings1.SLAEnabled = true
	require.NoError(t, app.DB.Save(settings1).Error)

	settings2 := testutil.CreateTestChatbotSettings(t, app.DB, org.ID, "account2")
	settings2.SLAEnabled = true
	require.NoError(t, app.DB.Save(settings2).Error)

	settingsList := []models.ChatbotSettings{*settings1, *settings2}

	// Manually cache
	cacheKey := "chatbot:sla_enabled_settings"
	data, err := json.Marshal(settingsList)
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), cacheKey, data, 6*time.Hour).Err()
	require.NoError(t, err)

	// Retrieve from cache
	result, err := app.GetSLAEnabledSettingsCached()
	require.NoError(t, err)
	assert.Len(t, result, 2)
}

