	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	// Create flows with steps
	flow1 := testutil.CreateTestChatbotFlow(t, app.DB, org.ID, "test-account")
	step1 := &models.ChatbotFlowStep{
		BaseModel: models.BaseModel{ID: uuid.New()},
		FlowID:    flow1.ID,
		StepOrder: 1,
		Message:   "Step 1",
	}
	require.NoError(t, app.DB.Create(step1).Error)

	// Retrieve from DB
	result, err := app.GetChatbotFlowsCached(org.ID)
	require.NoError(t, err)
	assert.Len(t, result, 1)
	assert.Len(t, result[0].Steps, 1)
	assert.Equal(t, "Step 1", result[0].Steps[0].Message)
}

// TestApp_getChatbotFlowsCached_OnlyEnabled tests that only enabled flows are returned
