	var resp handlers.MessageResponse
	require.NoError(t, json.Unmarshal(testutil.GetResponseBody(req), &resp))
	assert.Equal(t, "interactive", resp.MessageType)
	assert.NotNil(t, resp.InteractiveData)
}

// TestSendMessage_ReplyTo tests sending a reply to an existing message
func TestSendMessage_ReplyTo(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Updates(map[string]any{
			"assigned_user_id": user.ID,
			"status":           models.ChatStatusOpen,
		}).Error)

	// Create original message to reply to
	originalMsg := &models.Message{
		BaseModel:      models.BaseModel{ID: uuid.New()},
		OrganizationID: org.ID,
		ContactID:      contact.ID,
		Direction:      models.DirectionIncoming,
		MessageType:    models.MessageTypeText,
		Content:        "Original message",
		Status:         models.MessageStatusReceived,
	}
	require.NoError(t, app.DB.Create(originalMsg).Error)

	req := testutil.NewJSONRequest(t, map[string]interface{}{
		"type":                "text",
		"reply_to_message_id": originalMsg.ID.String(),
		"content": map[string]string{
			"body": "Reply message",
		},
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())

	err := app.SendMessage(req)
	require.NoError(t, err)
	assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

	var resp handlers.MessageResponse
	require.NoError(t, json.Unmarshal(testutil.GetResponseBody(req), &resp))
	assert.True(t, resp.IsReply)
	assert.NotNil(t, resp.ReplyToMessageID)
	assert.Equal(t, originalMsg.ID.String(), *resp.ReplyToMessageID)
	assert.NotNil(t, resp.ReplyToMessage)
	assert.Equal(t, "Original message", resp.ReplyToMessage.Content["body"])
}

// TestSendMessage_ClosedChatRejected tests that messages to closed chats are rejected
func TestSendMessage_ClosedChatRejected(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	// Set contact status to closed
	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Update("status", models.ChatStatusClosed).Error)

	req := testutil.NewJSONRequest(t, map[string]interface{}{
		"type": "text",
		"content": map[string]string{
			"body": "This should fail",
		},
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())

	err := app.SendMessage(req)
	require.NoError(t, err)
	assert.Equal(t, fasthttp.StatusConflict, testutil.GetResponseStatusCode(req))

	testutil.AssertErrorResponse(t, req, fasthttp.StatusConflict, "Closed chats are read-only")
}

// TestSendMessage_UnassignedChatRejected tests that unassigned chats are rejected
func TestSendMessage_UnassignedChatRejected(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	// Keep contact unassigned (no assigned_user_id)
	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Update("status", models.ChatStatusOpen).Error)

	req := testutil.NewJSONRequest(t, map[string]interface{}{
		"type": "text",
		"content": map[string]string{
			"body": "This should fail",
		},
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())

	err := app.SendMessage(req)
	require.NoError(t, err)
	assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))

	testutil.AssertErrorResponse(t, req, fasthttp.StatusForbidden, "unassigned")
}

// TestSendMessage_InvalidRequest tests invalid request handling
func TestSendMessage_InvalidRequest(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name           string
		requestBody    interface{}
		expectedStatus int
		expectedError  string
	}{
		{
			name:           "invalid JSON",
			requestBody:    "invalid json",
			expectedStatus: fasthttp.StatusBadRequest,
			expectedError:  "Invalid request body",
		},
		{
			name:           "missing content",
			requestBody:    map[string]interface{}{"type": "text"},
			expectedStatus: fasthttp.StatusOK, // Empty body is allowed
		},
		{
			name: "missing type",
			requestBody: map[string]interface{}{
				"content": map[string]string{"body": "test"},
			},
			expectedStatus: fasthttp.StatusOK, // Default type will be used
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockServer := newMockWhatsAppServer()
			defer mockServer.close()

			app := newMsgTestApp(t, mockServer)
			org := testutil.CreateTestOrganization(t, app.DB)
			adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
			user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
			account := createTestAccount(t, app, org.ID)
			contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

			require.NoError(t, app.DB.Model(&models.Contact{}).
				Where("id = ?", contact.ID).
				Updates(map[string]any{
					"assigned_user_id": user.ID,
					"status":           models.ChatStatusOpen,
				}).Error)

			var req *fastglue.Request
			if str, ok := tt.requestBody.(string); ok {
				req = testutil.NewRequest(t)
				req.RequestCtx.Request.SetBody([]byte(str))
			} else {
				req = testutil.NewJSONRequest(t, tt.requestBody)
			}

			testutil.SetAuthContext(req, org.ID, user.ID)
			testutil.SetPathParam(req, "id", contact.ID.String())

			err := app.SendMessage(req)
			require.NoError(t, err)
			assert.Equal(t, tt.expectedStatus, testutil.GetResponseStatusCode(req))

			if tt.expectedError != "" {
				testutil.AssertErrorResponse(t, req, tt.expectedStatus, tt.expectedError)
			}
		})
	}
}

// TestSendMessage_ContactNotFound tests handling of non-existent contacts
func TestSendMessage_ContactNotFound(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

	req := testutil.NewJSONRequest(t, map[string]interface{}{
		"type": "text",
		"content": map[string]string{
			"body": "Test",
		},
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", uuid.New().String())

	err := app.SendMessage(req)
	require.NoError(t, err)
