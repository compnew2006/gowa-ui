// TestApp_getChatbotSettingsCached_CacheHit tests retrieving settings from cache
func TestApp_getChatbotSettingsCached_CacheHit(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)
	whatsAppAccount := "test-account"

	// Create and encrypt settings
	encryptedKey, err := crypto.Encrypt("test-api-key", app.Config.App.EncryptionKey)
	require.NoError(t, err)

	settings := &models.ChatbotSettings{
		OrganizationID:  org.ID,
		WhatsAppAccount: whatsAppAccount,
		IsEnabled:       true,
		DefaultResponse: "Hello!",
		AI: models.AIConfig{
			Enabled: true,
			APIKey:  encryptedKey,
			Model:   "gpt-4",
		},
	}
	require.NoError(t, app.DB.Create(settings).Error)

	// Manually cache the settings
	cacheKey := "chatbot:settings:" + org.ID.String() + ":" + whatsAppAccount
	cacheData := chatbotSettingsCache{
		ChatbotSettings: *settings,
		AIAPIKey:        encryptedKey,
	}
	data, err := json.Marshal(cacheData)
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), cacheKey, data, 6*time.Hour).Err()
	require.NoError(t, err)

	// Retrieve from cache
	result, err := app.GetChatbotSettingsCached(org.ID, whatsAppAccount)
	require.NoError(t, err)
	assert.Equal(t, settings.ID, result.ID)
	assert.Equal(t, settings.DefaultResponse, result.DefaultResponse)
	assert.True(t, result.AI.Enabled)
	assert.Equal(t, "gpt-4", result.AI.Model)
	assert.Equal(t, "test-api-key", result.AI.APIKey) // Decrypted
}

// TestApp_getChatbotSettingsCached_CacheMiss tests retrieving settings from database on cache miss
func TestApp_getChatbotSettingsCached_CacheMiss(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)
	whatsAppAccount := "test-account"

	// Create settings in database
	encryptedKey, err := crypto.Encrypt("test-api-key", app.Config.App.EncryptionKey)
	require.NoError(t, err)

	settings := &models.ChatbotSettings{
		OrganizationID:  org.ID,
		WhatsAppAccount: whatsAppAccount,
		IsEnabled:       true,
		DefaultResponse: "Hello from DB!",
		AI: models.AIConfig{
			Enabled: true,
			APIKey:  encryptedKey,
			Model:   "gpt-4",
		},
	}
	require.NoError(t, app.DB.Create(settings).Error)

	// Retrieve (should fetch from DB and cache)
	result, err := app.GetChatbotSettingsCached(org.ID, whatsAppAccount)
	require.NoError(t, err)
	assert.Equal(t, settings.DefaultResponse, result.DefaultResponse)
	assert.Equal(t, "test-api-key", result.AI.APIKey) // Decrypted

	// Verify it was cached
	cacheKey := "chatbot:settings:" + org.ID.String() + ":" + whatsAppAccount
	cached, err := app.Redis.Get(context.Background(), cacheKey).Result()
	require.NoError(t, err)
	assert.NotEmpty(t, cached)
}

// TestApp_getChatbotSettingsCached_PrefersAccountSpecific tests that account-specific settings are preferred
func TestApp_getChatbotSettingsCached_PrefersAccountSpecific(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)
	whatsAppAccount := "test-account"

	// Create global settings
	globalSettings := &models.ChatbotSettings{
		OrganizationID:  org.ID,
		WhatsAppAccount: "", // Global
		IsEnabled:       true,
		DefaultResponse: "Global response",
	}
	require.NoError(t, app.DB.Create(globalSettings).Error)

	// Create account-specific settings
	accountSettings := &models.ChatbotSettings{
		OrganizationID:  org.ID,
		WhatsAppAccount: whatsAppAccount,
		IsEnabled:       true,
		DefaultResponse: "Account-specific response",
	}
	require.NoError(t, app.DB.Create(accountSettings).Error)

	// Should return account-specific settings
	result, err := app.GetChatbotSettingsCached(org.ID, whatsAppAccount)
	require.NoError(t, err)
	assert.Equal(t, "Account-specific response", result.DefaultResponse)
}

// TestApp_getChatbotSettingsCached_DecryptionError tests error handling when decryption fails
func TestApp_getChatbotSettingsCached_DecryptionError(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)
	whatsAppAccount := "test-account"

	// Create settings with invalid encrypted key
	settings := &models.ChatbotSettings{
		OrganizationID:  org.ID,
		WhatsAppAccount: whatsAppAccount,
		AI: models.AIConfig{
			APIKey: "invalid-encrypted-key",
		},
	}
	require.NoError(t, app.DB.Create(settings).Error)

	// Should return error
	_, err := app.GetChatbotSettingsCached(org.ID, whatsAppAccount)
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "failed to decrypt")
}

