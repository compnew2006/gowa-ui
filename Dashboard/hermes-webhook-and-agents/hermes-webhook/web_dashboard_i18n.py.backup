        <div class="header">
            <div class="header-top">
                <div>
                    <h1 id="pageTitle">💬 Facebook Comments Dashboard</h1>
                    <p class="page-id">Page ID: {{ page_id }}</p>
                </div>
                <div class="theme-controls">
                    <button class="control-btn" onclick="toggleTheme()" id="themeBtn">
                        🌙 <span data-i18n="darkMode">Dark</span>
                    </button>
                    <button class="control-btn" onclick="toggleLanguage()" id="langBtn">
                        🌐 <span data-i18n="english">English</span>
                    </button>
                </div>
            </div>

