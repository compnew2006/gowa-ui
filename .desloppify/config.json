{
  "target_strict_score": 95,
  "review_max_age_days": 30,
  "review_batch_max_files": 80,
  "holistic_max_age_days": 30,
  "generate_scorecard": true,
  "badge_path": "scorecard.png",
  "exclude": [
    ".git",
    "node_modules",
    ".codex",
    ".opencode",
    ".repro_archive",
    ".ruvector",
    ".serena",
    ".specify",
    ".claude",
    ".agent",
    "uploads",
    "test-results",
    "mcp-server",
    "frontend/dist",
    "frontend/node_modules",
    "frontend/playwright-report",
    "frontend/test-results",
    "security_reports",
    "*.out",
    "*.html",
    "coverage.*",
    "frontend_*.txt",
    "frontend_*.json",
    "semgrep_*",
    "*.db",
    "whatomate",
    "agent",
    "docker",
    "go_*",
    "tmp_*",
    "deep_learning.py",
    "serve_acp_with_proxy.py",
    "gen_md_structure.py",
    "repro_*",
    "*_report.md",
    "files_over_500_lines.txt",
    "code_files_over_500_lines.txt",
    "large_files_report.md",
    "frontend_lint.json",
    "frontend_tsc.txt",
    "frontend_typecheck.txt",
    "frontend_audit*",
    "diagnostics_report.md",
    "bin",
    "docs/node_modules",
    "docs/dist",
    ".agents",
    ".desloppify",
    ".backup_old_tests",
    ".github",
    ".vscode"
  ],
  "ignore": [],
  "ignore_metadata": {},
  "zone_overrides": {},
  "review_dimensions": [],
  "large_files_threshold": 0,
  "props_threshold": 0,
  "issue_noise_budget": 10,
  "issue_noise_global_budget": 0,
  "execution_log_max_entries": 10000,
  "needs_rescan": false,
  "languages": {},
  "commit_tracking_enabled": true,
  "commit_pr": 0,
  "commit_default_branch": "",
  "commit_message_template": "desloppify: {status} {count} issue(s) \u2014 {summary}",
  "trust_plugins": false
}
