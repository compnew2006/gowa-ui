// TestSendMessage_InstanceSelection tests instance selection for whatsmeow
func TestSendMessage_InstanceSelection(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	app.Config.WhatsApp.Provider = "whatsmeow"
	app.MessageProvider = &stubMessageProvider{}

	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

	instance1 := createTestInstance(t, app, org.ID, "Instance 1")
	instance2 := createTestInstance(t, app, org.ID, "Instance 2")
	require.NoError(t, app.DB.Model(instance1).Updates(map[string]any{
		"status":       models.InstanceStatusConnected,
		"phone_number": "201001",
	}).Error)
	require.NoError(t, app.DB.Model(instance2).Updates(map[string]any{
		"status":       models.InstanceStatusConnected,
		"phone_number": "201002",
	}).Error)

	contact := testutil.CreateTestContactWith(t, app.DB, org.ID)
	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Updates(map[string]any{
			"instance_id":      instance2.ID,
			"assigned_user_id": user.ID,
			"status":           models.ChatStatusOpen,
		}).Error)

	t.Run("uses contact instance by default", func(t *testing.T) {
		req := testutil.NewJSONRequest(t, map[string]interface{}{
			"type": "text",
			"content": map[string]string{
				"body": "Test",
			},
		})
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.SendMessage(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))
	})

	t.Run("overrides instance when specified", func(t *testing.T) {
		req := testutil.NewJSONRequest(t, map[string]interface{}{
			"type":        "text",
			"content":     map[string]string{"body": "Test"},
			"instance_id": instance1.ID.String(),
		})
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.SendMessage(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))
	})
}

