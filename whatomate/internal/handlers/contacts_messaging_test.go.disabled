	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	instance := createTestInstance(t, app, org.ID, "Test Instance")

	// Set last_message_at to be old so update will apply
	oldTime := time.Now().Add(-1 * time.Hour)

	message := &models.Message{
		BaseModel:          models.BaseModel{ID: uuid.New(), CreatedAt: oldTime},
		OrganizationID:     org.ID,
		ContactID:          contact.ID,
		InstanceID:         &instance.ID,
		WhatsAppMessageID:  "wamid.test123",
		Direction:          models.DirectionOutgoing,
		MessageType:        models.MessageTypeText,
		Content:            "Test message to revoke",
		Status:             models.MessageStatusSent,
		SentByUserID:       &user.ID,
	}
	require.NoError(t, app.DB.Create(message).Error)

	// Set initial preview
	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Update("last_message_preview", "Original message").Error)

	req := testutil.NewRequest(t)
	req.RequestCtx.Request.Header.SetMethod(fasthttp.MethodPost)
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())
	testutil.SetPathParam(req, "message_id", message.ID.String())

	err := app.RevokeMessage(req)
	require.NoError(t, err)
	assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

	// Verify contact preview was updated
	var updatedContact models.Contact
	require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updatedContact).Error)
	assert.Contains(t, updatedContact.LastMessagePreview, "deleted")
}

// TestSendMessage_AsyncDelivery tests async message delivery
func TestSendMessage_AsyncDelivery(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Updates(map[string]any{
			"assigned_user_id": user.ID,
			"status":           models.ChatStatusOpen,
		}).Error)

	req := testutil.NewJSONRequest(t, map[string]interface{}{
		"type": "text",
		"content": map[string]string{
			"body": "Async message",
		},
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())

	err := app.SendMessage(req)
	require.NoError(t, err)
	assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

	// Message should be in database
	var messages []models.Message
	require.NoError(t, app.DB.Where("contact_id = ?", contact.ID).Find(&messages).Error)
	assert.Greater(t, len(messages), 0)
}

// TestSendMediaMessage_AllTypes tests all supported media types
func TestSendMediaMessage_AllTypes(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Updates(map[string]any{
			"assigned_user_id": user.ID,
			"status":           models.ChatStatusOpen,
		}).Error)

	mediaTypes := []struct {
		name          string
		filename      string
		mimeType      string
		data          []byte
		expectedType  string
	}{
		{
			name:         "JPEG image",
			filename:     "test.jpg",
			mimeType:     "image/jpeg",
			data:         []byte{0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46},
			expectedType: "image",
		},
		{
			name:         "PNG image",
			filename:     "test.png",
			mimeType:     "image/png",
			data:         []byte{0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a},
			expectedType: "image",
		},
		{
			name:         "PDF document",
			filename:     "test.pdf",
			mimeType:     "application/pdf",
			data:         []byte("%PDF-1.4"),
			expectedType: "document",
		},
		{
			name:         "MP4 video",
			filename:     "test.mp4",
			mimeType:     "video/mp4",
			data:         []byte{0x00, 0x00, 0x00, 0x20, 0x66, 0x74, 0x79, 0x70},
			expectedType: "video",
		},
		{
			name:         "MP3 audio",
			filename:     "test.mp3",
			mimeType:     "audio/mpeg",
			data:         []byte("ID3"),
			expectedType: "audio",
		},
	}

	for _, mt := range mediaTypes {
		t.Run(mt.name, func(t *testing.T) {
			// Extend data to be valid
			testData := make([]byte, len(mt.data)+100)
			copy(testData, mt.data)

			req := createMediaRequest(t, org.ID, user.ID, contact.ID, mt.filename, mt.mimeType, testData, "")
			err := app.SendMediaMessage(req)
			require.NoError(t, err)
			assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

			var resp handlers.MessageResponse
			require.NoError(t, json.Unmarshal(testutil.GetResponseBody(req), &resp))
			assert.Equal(t, mt.expectedType, resp.MessageType)
		})
	}
}

// TestSendTypingPresence_BestEffort tests that typing presence is best-effort
func TestSendTypingPresence_BestEffort(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	// Don't set WhatsmeowManager - should return "ignored"
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	req := testutil.NewJSONRequest(t, map[string]string{
		"state": "composing",
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())

	err := app.SendTypingPresence(req)
