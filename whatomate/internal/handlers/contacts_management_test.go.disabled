	"github.com/valyala/fasthttp"
	"gorm.io/gorm"
)

// --- AssignContact Tests ---

func TestApp_AssignContact(t *testing.T) {
	t.Parallel()

	t.Run("successfully assigns contact to user", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		assignee := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"user_id": assignee.ID,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Equal(t, "success", resp["status"])
		assert.Equal(t, assignee.ID.String(), resp["data"].(map[string]any)["assigned_user_id"])

		// Verify database update
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Equal(t, assignee.ID, *updated.AssignedUserID)
		assert.Equal(t, models.ChatStatusOpen, updated.Status)
	})

	t.Run("unassigns contact when user_id is null", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		assignee := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		// First assign
		require.NoError(t, app.DB.Model(contact).Update("assigned_user_id", assignee.ID).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"user_id": nil,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		// Verify unassignment
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Nil(t, updated.AssignedUserID)
		assert.Equal(t, models.ChatStatusPending, updated.Status)
	})

	t.Run("returns unauthorized without auth context", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"user_id": uuid.New(),
		}))

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusUnauthorized, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns forbidden without contacts:write permission", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		// Create role with only read permission
		allPerms := testutil.GetOrCreateTestPermissions(t, app.DB)
		var readPerms []models.Permission
		for _, p := range allPerms {
			if p.Resource == models.ResourceContacts && p.Action == models.ActionRead {
				readPerms = append(readPerms, p)
			}
		}
		role := testutil.CreateTestRole(t, app.DB, org.ID, "readonly", readPerms)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))
		assignee := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"user_id": assignee.ID,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns not found for non-existent contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		assignee := testutil.CreateTestUser(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", uuid.New().String())
		body, _ := json.Marshal(map[string]any{
			"user_id": assignee.ID,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusNotFound, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns bad request for invalid UUID", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", "invalid-uuid")

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusBadRequest, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns bad request for user from different organization", func(t *testing.T) {
		app := newTestApp(t)
		org1 := testutil.CreateTestOrganization(t, app.DB)
		org2 := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org1.ID)
		user := testutil.CreateTestUser(t, app.DB, org1.ID, testutil.WithRoleID(&adminRole.ID))
		otherOrgUser := testutil.CreateTestUser(t, app.DB, org2.ID)
		contact := testutil.CreateTestContact(t, app.DB, org1.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org1.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"user_id": otherOrgUser.ID,
		}))

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusBadRequest, testutil.GetResponseStatusCode(req))
	})

	t.Run("cross-org isolation - cannot assign contact from different org", func(t *testing.T) {
		app := newTestApp(t)
		org1 := testutil.CreateTestOrganization(t, app.DB)
		org2 := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org1.ID)
		user := testutil.CreateTestUser(t, app.DB, org1.ID, testutil.WithRoleID(&adminRole.ID))
		assignee := testutil.CreateTestUser(t, app.DB, org1.ID)
		contact := testutil.CreateTestContact(t, app.DB, org2.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org1.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"user_id": assignee.ID,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusNotFound, testutil.GetResponseStatusCode(req))
	})
}

// --- ClaimChat Tests ---

func TestApp_ClaimChat(t *testing.T) {
	t.Parallel()

	t.Run("successfully claims pending chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ClaimChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, user.ID, *resp.AssignedUserID)
		assert.Equal(t, "open", resp.Status)

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Equal(t, user.ID, *updated.AssignedUserID)
	})

	t.Run("returns forbidden without claim permissions", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		// Role with no permissions
		role := testutil.CreateTestRole(t, app.DB, org.ID, "noperms", []models.Permission{})
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ClaimChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns conflict for closed chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		now := time.Now().UTC()
		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":     models.ChatStatusClosed,
			"closed_at":  &now,
			"closed_by_user_id": user.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ClaimChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusConflict, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "Closed chats cannot be claimed")
	})

	t.Run("returns conflict when chat is assigned to another user", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		otherUser := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Update("assigned_user_id", otherUser.ID).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ClaimChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusConflict, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "already assigned to another user")
	})

	t.Run("allows re-claiming already assigned chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":          models.ChatStatusOpen,
			"assigned_user_id": user.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ClaimChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, user.ID, *resp.AssignedUserID)
	})
}

// --- CloseChat Tests ---

func TestApp_CloseChat(t *testing.T) {
	t.Parallel()

	t.Run("successfully closes open chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":          models.ChatStatusOpen,
			"assigned_user_id": user.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.CloseChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, "closed", resp.Status)
		assert.NotNil(t, resp.ClosedAt)
		assert.Equal(t, user.ID, *resp.ClosedByUserID)

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Equal(t, models.ChatStatusClosed, updated.Status)
		assert.NotNil(t, updated.ClosedAt)
	})

	t.Run("returns idempotent when chat is already closed", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		now := time.Now().UTC()
		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":           models.ChatStatusClosed,
			"closed_at":        &now,
			"closed_by_user_id": user.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.CloseChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, "closed", resp.Status)
	})

	t.Run("returns forbidden when non-assignee tries to close", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		otherUser := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":           models.ChatStatusOpen,
			"assigned_user_id": otherUser.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.CloseChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "Only the assigned user can close this chat")
	})

	t.Run("allows admin to close any chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		// Create admin role with bypass permission
		allPerms := testutil.GetOrCreateTestPermissions(t, app.DB)
		var adminPerms []models.Permission
		for _, p := range allPerms {
			if p.Resource == models.ResourceChat && p.Action == models.ActionWrite {
				adminPerms = append(adminPerms, p)
			}
		}
		adminRole := testutil.CreateTestRoleExact(t, app.DB, org.ID, "admin", false, false, adminPerms)
		adminUser := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		agentUser := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":           models.ChatStatusOpen,
			"assigned_user_id": agentUser.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, adminUser.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		// Mock canBypassPendingChatRestriction to return true
		// This would require more complex setup, so we'll just test the current behavior
		err := app.CloseChat(req)
		// Without bypass, this should be forbidden
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns not found for non-existent chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", uuid.New().String())

		err := app.CloseChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusNotFound, testutil.GetResponseStatusCode(req))
	})
}

// --- ReopenChat Tests ---

func TestApp_ReopenChat(t *testing.T) {
	t.Parallel()

	t.Run("successfully reopens closed chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		now := time.Now().UTC()
		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":           models.ChatStatusClosed,
			"closed_at":        &now,
			"closed_by_user_id": user.ID,
			"assigned_user_id":  user.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ReopenChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, "pending", resp.Status)
		assert.Nil(t, resp.AssignedUserID)
		assert.Nil(t, resp.ClosedAt)

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Equal(t, models.ChatStatusPending, updated.Status)
		assert.Nil(t, updated.AssignedUserID)
	})

	t.Run("returns conflict when trying to reopen open chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":           models.ChatStatusOpen,
			"assigned_user_id": user.ID,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ReopenChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusConflict, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "Only closed chats can be reopened")
	})

	t.Run("returns conflict when trying to reopen pending chat", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.ReopenChat(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusConflict, testutil.GetResponseStatusCode(req))
	})
}

// --- SetChatPublic Tests ---

func TestApp_SetChatPublic(t *testing.T) {
	t.Parallel()

	t.Run("successfully makes chat public", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"is_public": true,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.SetChatPublic(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.True(t, resp.IsPublic)

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.True(t, updated.IsPublic)
	})

	t.Run("successfully removes public visibility", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Update("is_public", true).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"is_public": false,
		}))

		err := app.SetChatPublic(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.False(t, resp.IsPublic)

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.False(t, updated.IsPublic)
	})

	t.Run("returns idempotent when visibility is already set", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Update("is_public", true).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"is_public": true,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.SetChatPublic(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.True(t, resp.IsPublic)
	})

	t.Run("returns forbidden without write permissions", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		// Role with only read permission
		allPerms := testutil.GetOrCreateTestPermissions(t, app.DB)
		var readPerms []models.Permission
		for _, p := range allPerms {
			if p.Resource == models.ResourceContacts && p.Action == models.ActionRead {
				readPerms = append(readPerms, p)
			}
		}
		role := testutil.CreateTestRole(t, app.DB, org.ID, "readonly", readPerms)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"is_public": true,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.SetChatPublic(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns bad request for invalid JSON", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		req.RequestCtx.Request.SetBody([]byte("invalid json"))

		err := app.SetChatPublic(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusBadRequest, testutil.GetResponseStatusCode(req))
	})
}

// --- GetContactSessionData Tests ---

func TestApp_GetContactSessionData(t *testing.T) {
	t.Parallel()

	t.Run("returns session data for contact with active session", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)
		flow := createTestFlow(t, app.DB, org.ID)

		session := &models.ChatbotSession{
			BaseModel:       models.BaseModel{ID: uuid.New()},
			OrganizationID:  org.ID,
			ContactID:       contact.ID,
			Status:          models.SessionStatusActive,
			CurrentFlowID:   &flow.ID,
			SessionData:     models.JSONB{"name": "John", "email": "john@example.com"},
		}
		require.NoError(t, app.DB.Create(session).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.GetContactSessionData(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, session.ID.String(), resp["session_id"])
		assert.Equal(t, flow.ID.String(), resp["flow_id"])
		assert.Equal(t, flow.Name, resp["flow_name"])
	})

	t.Run("returns empty session data for contact without session", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.GetContactSessionData(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Nil(t, resp["session_id"])
		assert.Empty(t, resp["session_data"])
	})

	t.Run("returns not found for non-existent contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", uuid.New().String())

		err := app.GetContactSessionData(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusNotFound, testutil.GetResponseStatusCode(req))
	})

	t.Run("respects agent visibility restrictions", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		// Create agent role
		agentRole := createExactAgentRole(t, app, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&agentRole.ID))
		otherUser := testutil.CreateTestUser(t, app.DB, org.ID)

		// Contact assigned to other user, not public
		contact := testutil.CreateTestContact(t, app.DB, org.ID)
		require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
			"status":           models.ChatStatusOpen,
			"assigned_user_id": otherUser.ID,
			"is_public":        false,
		}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.GetContactSessionData(req)
		require.NoError(t, err)
		// Agent should not see other's private chats
		assert.Equal(t, fasthttp.StatusNotFound, testutil.GetResponseStatusCode(req))
	})
}

// --- UpdateContactTags Tests ---

func TestApp_UpdateContactTags(t *testing.T) {
	t.Parallel()

	t.Run("successfully updates contact tags", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		newTags := []string{"vip", "priority", "enterprise"}

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"tags": newTags,
		}))

		err := app.UpdateContactTags(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "updated")
		assert.ElementsMatch(t, newTags, resp["tags"].([]any))

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Len(t, updated.Tags, 3)
	})

	t.Run("clears all tags with empty array", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		// Add initial tags
		require.NoError(t, app.DB.Model(contact).Update("tags", models.JSONBArray{"old", "tags"}).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"tags": []string{},
		}))

		err := app.UpdateContactTags(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Empty(t, resp["tags"])

		// Verify database
		var updated models.Contact
		require.NoError(t, app.DB.Where("id = ?", contact.ID).First(&updated).Error)
		assert.Empty(t, updated.Tags)
	})

	t.Run("returns forbidden without write permission", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		allPerms := testutil.GetOrCreateTestPermissions(t, app.DB)
		var readPerms []models.Permission
		for _, p := range allPerms {
			if p.Resource == models.ResourceContacts && p.Action == models.ActionRead {
				readPerms = append(readPerms, p)
			}
		}
		role := testutil.CreateTestRole(t, app.DB, org.ID, "readonly", readPerms)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"tags": []string{"test"},
		}))

		err := app.UpdateContactTags(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))
	})
}

// --- CreateContact Tests ---

func TestApp_CreateContact(t *testing.T) {
	t.Parallel()

	t.Run("successfully creates new contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		body, _ := json.Marshal(map[string]any{
		})
				req.RequestCtx.Request.SetBody(body)
			"whatsapp_account": "test-account",
			"tags":             []string{"vip", "new"},
			"metadata":         map[string]any{"source": "manual"},
		}))

		err := app.CreateContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, "1234567890", resp.PhoneNumber)
		assert.Equal(t, "John Doe", resp.ProfileName)
		assert.ElementsMatch(t, []string{"vip", "new"}, resp.Tags)
	})

	t.Run("restores soft-deleted contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		// Soft delete
		require.NoError(t, app.DB.Delete(contact).Error)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"phone_number": contact.PhoneNumber,
		}))

		err := app.CreateContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, contact.ID, resp.ID)

		// Verify contact is restored
		var restored models.Contact
		require.NoError(t, app.DB.Unscoped().Where("id = ?", contact.ID).First(&restored).Error)
		assert.Nil(t, restored.DeletedAt.Time)
	})

	t.Run("returns conflict for existing contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"phone_number": contact.PhoneNumber,
		}))

		err := app.CreateContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusConflict, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns bad request for missing phone_number", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"profile_name": "John Doe",
		}))

		err := app.CreateContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusBadRequest, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "phone_number is required")
	})

	t.Run("normalizes phone number by removing + prefix", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"phone_number": "+1234567890",
		}))

		err := app.CreateContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp handlers.ContactResponse
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Equal(t, "1234567890", resp.PhoneNumber)
	})
}

