# Transport mode: stdio | http | hybrid
MCP_TRANSPORT=stdio

# HTTP transport settings (required for http/hybrid)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_BEARER_TOKEN=replace_me
MCP_ENABLE_LEGACY_SSE=false
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=info
LOG_FILE=/tmp/whatomate-mcp.log

# Whatomate API integration
WHATOMATE_BASE_URL=http://localhost:8080
WHATOMATE_API_KEY=whm_replace_me
WHATOMATE_ORGANIZATION_ID=

# OpenAI connector
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# Optional advanced settings
MCP_REQUEST_TIMEOUT_MS=30000
MCP_GET_RETRIES=2
MCP_OUTBOUND_HOST_ALLOWLIST=
