// TestApp_getWhatsAppAccountCached_CacheHit tests retrieving WhatsApp account from cache
func TestApp_getWhatsAppAccountCached_CacheHit(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	// Create account with encrypted secrets
	encryptedToken, err := crypto.Encrypt("test-token", app.Config.App.EncryptionKey)
	require.NoError(t, err)
	encryptedSecret, err := crypto.Encrypt("test-secret", app.Config.App.EncryptionKey)
	require.NoError(t, err)

	account := &models.WhatsAppAccount{
		OrganizationID: org.ID,
		Name:           "test-account",
		PhoneID:        "phone123",
		BusinessID:     "business123",
		AccessToken:    encryptedToken,
		AppSecret:      encryptedSecret,
	}
	require.NoError(t, app.DB.Create(account).Error)

	// Manually cache
	cacheKey := "whatsapp:account:phone123"
	cacheData := whatsAppAccountCache{
		WhatsAppAccount: *account,
		AccessToken:     encryptedToken,
		AppSecret:       encryptedSecret,
	}
	data, err := json.Marshal(cacheData)
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), cacheKey, data, 6*time.Hour).Err()
	require.NoError(t, err)

	// Retrieve from cache
	result, err := app.GetWhatsAppAccountCached("phone123")
	require.NoError(t, err)
	assert.Equal(t, account.ID, result.ID)
	assert.Equal(t, "test-token", result.AccessToken) // Decrypted
	assert.Equal(t, "test-secret", result.AppSecret) // Decrypted
}

