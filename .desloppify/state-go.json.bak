    "review::.::holistic::initialization_coupling::mutable-pkg-level-cached-template": {
      "id": "review::.::holistic::initialization_coupling::mutable-pkg-level-cached-template",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "cachedIndexHTMLTemplate is a mutable package-level variable written during Handler() calls",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "internal/frontend/embed.go"
        ],
        "evidence": [
          "var cachedIndexHTMLTemplate []byte (line 42) is a package-level mutable variable that gets written inside Handler() at line 80: cachedIndexHTMLTemplate = []byte(...). If Handler() were called concurrently with different basePath values, this would be a data race. The variable exists solely to avoid passing state through the closure chain."
        ],
        "suggestion": "Move cachedIndexHTMLTemplate to be a local variable inside the Handler() closure, or store it as a field on a struct returned by Handler(). This eliminates the package-level mutable state and potential race condition.",
        "reasoning": "",
        "summary_hash": "0369499a"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-05-08T11:00:09+00:00",
