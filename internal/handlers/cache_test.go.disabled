// TestApp_HasPermission_Success tests permission check
func TestApp_HasPermission_Success(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	role := testutil.CreateTestRoleWithKeys(t, app.DB, org.ID, "test-role", []string{"users:read", "users:write"})
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))

	// Test existing permission
	hasPermission := app.HasPermission(user.ID, "users", "read", org.ID)
	assert.True(t, hasPermission)

	// Test non-existing permission
	hasPermission = app.HasPermission(user.ID, "users", "delete", org.ID)
	assert.False(t, hasPermission)
}

// TestApp_HasPermission_SuperAdmin tests super admin has all permissions
func TestApp_HasPermission_SuperAdmin(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	user := &models.User{
		OrganizationID: org.ID,
		Email:          "superadmin@example.com",
		FullName:       "Super Admin",
		PasswordHash:   "hash",
		IsSuperAdmin:   true,
	}
	require.NoError(t, app.DB.Create(user).Error)

	// Super admin should have all permissions
	hasPermission := app.HasPermission(user.ID, "any", "action", org.ID)
	assert.True(t, hasPermission)
}

// TestApp_HasAnyPermission_Success tests checking any of multiple permissions
func TestApp_HasAnyPermission_Success(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	role := testutil.CreateTestRoleWithKeys(t, app.DB, org.ID, "test-role", []string{"users:read", "users:write"})
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))

	// Test with one matching permission
	hasAny := app.HasAnyPermission(user.ID, "users:read", "users:delete")
	assert.True(t, hasAny)

	// Test with no matching permissions
	hasAny = app.HasAnyPermission(user.ID, "users:delete", "teams:delete")
	assert.False(t, hasAny)
}

// TestApp_IsSuperAdmin tests checking if user is super admin
func TestApp_IsSuperAdmin(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	// Create super admin
	superAdmin := &models.User{
		OrganizationID: org.ID,
		Email:          "superadmin@example.com",
		FullName:       "Super Admin",
		PasswordHash:   "hash",
		IsSuperAdmin:   true,
	}
	require.NoError(t, app.DB.Create(superAdmin).Error)

	// Create regular user
	regularUser := testutil.CreateTestUser(t, app.DB, org.ID)

	// Test super admin
	assert.True(t, app.IsSuperAdmin(superAdmin.ID))

	// Test regular user
	assert.False(t, app.IsSuperAdmin(regularUser.ID))
}
