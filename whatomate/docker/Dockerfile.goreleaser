# Dockerfile for GoReleaser builds
# The binary is pre-built by GoReleaser

FROM alpine:3.19

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create a non-root user and group
RUN addgroup -S whatomate && adduser -S whatomate -G whatomate

# Copy pre-built binary from GoReleaser
COPY whatomate .

# Create uploads directory and set ownership
RUN mkdir -p /app/uploads && chown -R whatomate:whatomate /app

# Switch to non-root user
USER whatomate

# Expose port
EXPOSE 8080

# Run the binary
ENTRYPOINT ["./whatomate"]
CMD ["server", "-migrate"]
