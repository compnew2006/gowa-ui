// --- WebSocket broadcast integration test ---

func TestApp_ContactLifecycleWebSocketBroadcast(t *testing.T) {
	t.Parallel()

	t.Run("broadcasts contact update on assignment change", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		assignee := testutil.CreateTestUser(t, app.DB, org.ID)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		// Create a mock WSHub
		hub := &mockWebSocketHub{}
		app.WSHub = hub

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
			"user_id": assignee.ID,
		})
		req.RequestCtx.Request.SetBody(body)

		err := app.AssignContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		// Verify broadcast was called
		assert.True(t, hub.broadcastToOrgCalled)
		assert.True(t, hub.broadcastToUserCalled)
		assert.Equal(t, org.ID, hub.lastOrgID)
		assert.Equal(t, assignee.ID, hub.lastUserID)
	})
}

// --- Mock WebSocket Hub for testing ---

type mockWebSocketHub struct {
	broadcastToOrgCalled bool
	broadcastToUserCalled bool
	lastOrgID            uuid.UUID
	lastUserID           uuid.UUID
	lastMessage          websocket.WSMessage
}

func (m *mockWebSocketHub) BroadcastToOrg(orgID uuid.UUID, msg websocket.WSMessage) {
	m.broadcastToOrgCalled = true
	m.lastOrgID = orgID
	m.lastMessage = msg
}

func (m *mockWebSocketHub) BroadcastToUser(orgID uuid.UUID, userID uuid.UUID, msg websocket.WSMessage) {
	m.broadcastToUserCalled = true
	m.lastOrgID = orgID
	m.lastUserID = userID
	m.lastMessage = msg
}

// Helper to create test flows
func createTestFlow(t *testing.T, db *gorm.DB, orgID uuid.UUID) *models.ChatbotFlow {
	t.Helper()

	account := testutil.CreateTestWhatsAppAccount(t, db, orgID)

	flow := &models.ChatbotFlow{
		BaseModel:       models.BaseModel{ID: uuid.New()},
		OrganizationID:  orgID,
		WhatsAppAccount: account.Name,
		Name:            "Test Flow",
		PanelConfig:     models.JSONB{"sections": []any{}},
	}
	require.NoError(t, db.Create(flow).Error)
	return flow
}
