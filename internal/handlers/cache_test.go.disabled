// TestApp_getKeywordRulesCached_CacheMiss tests retrieving rules from database
func TestApp_getKeywordRulesCached_CacheMiss(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)
	whatsAppAccount := "test-account"

	// Create account-specific and global rules
	accountRule := testutil.CreateTestKeywordRule(t, app.DB, org.ID, whatsAppAccount)
	globalRule := testutil.CreateTestKeywordRule(t, app.DB, org.ID, "") // Global

	// Retrieve from DB
	result, err := app.GetKeywordRulesCached(org.ID, whatsAppAccount)
	require.NoError(t, err)
	assert.Len(t, result, 2) // Both rules

	// Account-specific rules should come first
	assert.Equal(t, accountRule.ID, result[0].ID)
	assert.Equal(t, globalRule.ID, result[1].ID)
}

