func TestSendMessage_NewConversation(t *testing.T) {
	t.Parallel()

	mockServer := newMockWhatsAppServer()
	defer mockServer.close()

	app := newMsgTestApp(t, mockServer)
	org := testutil.CreateTestOrganization(t, app.DB)
	adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
	account := createTestAccount(t, app, org.ID)
	contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

	require.NoError(t, app.DB.Model(&models.Contact{}).
		Where("id = ?", contact.ID).
		Updates(map[string]any{
			"assigned_user_id": user.ID,
			"status":           models.ChatStatusOpen,
		}).Error)

	req := testutil.NewJSONRequest(t, map[string]interface{}{
		"type": "text",
		"content": map[string]string{
			"body": "Message creating new conversation",
		},
	})
	testutil.SetAuthContext(req, org.ID, user.ID)
	testutil.SetPathParam(req, "id", contact.ID.String())

	err := app.SendMessage(req)
	require.NoError(t, err)
	assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

	var resp handlers.MessageResponse
	require.NoError(t, json.Unmarshal(testutil.GetResponseBody(req), &resp))

	// New conversation should be created
	assert.NotEqual(t, uuid.Nil, resp.ConversationID)

	var conversation models.Conversation
	require.NoError(t, app.DB.Where("id = ?", resp.ConversationID).First(&conversation).Error)
	assert.Equal(t, contact.ID, conversation.ContactID)
}

// TestSendMessage_ErrorPaths tests various error paths
func TestSendMessage_ErrorPaths(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name           string
		setupContact   func(*testing.T, *handlers.App, *models.Contact)
		expectedStatus int
		expectedError  string
	}{
		{
			name: "closed chat",
			setupContact: func(t *testing.T, app *handlers.App, contact *models.Contact) {
				t.Helper()
				require.NoError(t, app.DB.Model(contact).Update("status", models.ChatStatusClosed).Error)
			},
			expectedStatus: fasthttp.StatusConflict,
			expectedError:  "Closed chats are read-only",
		},
		{
			name: "unassigned chat",
			setupContact: func(t *testing.T, app *handlers.App, contact *models.Contact) {
				t.Helper()
				require.NoError(t, app.DB.Model(contact).Updates(map[string]any{
					"assigned_user_id": nil,
					"status":           models.ChatStatusOpen,
				}).Error)
			},
			expectedStatus: fasthttp.StatusForbidden,
			expectedError:  "unassigned",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockServer := newMockWhatsAppServer()
			defer mockServer.close()

			app := newMsgTestApp(t, mockServer)
			org := testutil.CreateTestOrganization(t, app.DB)
			adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
			user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
			account := createTestAccount(t, app, org.ID)
			contact := testutil.CreateTestContactWith(t, app.DB, org.ID, testutil.WithContactAccount(account.Name))

			// Set initial state
			require.NoError(t, app.DB.Model(&models.Contact{}).
				Where("id = ?", contact.ID).
				Updates(map[string]any{
					"assigned_user_id": user.ID,
					"status":           models.ChatStatusOpen,
				}).Error)

			// Apply test-specific setup
			tt.setupContact(t, app, contact)

			req := testutil.NewJSONRequest(t, map[string]interface{}{
				"type": "text",
				"content": map[string]string{
					"body": "Test",
				},
			})
			testutil.SetAuthContext(req, org.ID, user.ID)
			testutil.SetPathParam(req, "id", contact.ID.String())

			err := app.SendMessage(req)
			require.NoError(t, err)
			assert.Equal(t, tt.expectedStatus, testutil.GetResponseStatusCode(req))

			if tt.expectedError != "" {
				testutil.AssertErrorResponse(t, req, tt.expectedStatus, tt.expectedError)
			}
		})
	}
}
