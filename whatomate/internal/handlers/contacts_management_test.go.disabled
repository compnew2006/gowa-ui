		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())
		body, _ := json.Marshal(map[string]any{
		})
		req.RequestCtx.Request.SetBody(body)
			"assigned_user_id": uuid.New(),
		}))

		err := app.UpdateContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusBadRequest, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseJSONResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "Assigned user not found")
	})
}

// --- DeleteContact Tests ---

func TestApp_DeleteContact(t *testing.T) {
	t.Parallel()

	t.Run("successfully soft-deletes contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.DeleteContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusOK, testutil.GetResponseStatusCode(req))

		var resp map[string]any
		testutil.ParseEnvelopeResponse(t, req, &resp)
		assert.Contains(t, resp["message"], "deleted")

		// Verify soft delete
		var deleted models.Contact
		err = app.DB.Unscoped().Where("id = ?", contact.ID).First(&deleted).Error
		require.NoError(t, err)
		assert.NotNil(t, deleted.DeletedAt.Time)

		// Verify it's not found in normal query
		var notFound models.Contact
		err = app.DB.Where("id = ?", contact.ID).First(&notFound).Error
		assert.Error(t, err)
	})

	t.Run("returns forbidden without delete permission", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		allPerms := testutil.GetOrCreateTestPermissions(t, app.DB)
		var writePerms []models.Permission
		for _, p := range allPerms {
			if p.Resource == models.ResourceContacts && p.Action == models.ActionWrite {
				writePerms = append(writePerms, p)
			}
		}
		role := testutil.CreateTestRole(t, app.DB, org.ID, "writer", writePerms)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", contact.ID.String())

		err := app.DeleteContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusForbidden, testutil.GetResponseStatusCode(req))
	})

	t.Run("returns not found for non-existent contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		adminRole := testutil.CreateAdminRole(t, app.DB, org.ID)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&adminRole.ID))

		req := testutil.NewRequest(t)
		testutil.SetAuthContext(req, org.ID, user.ID)
		testutil.SetPathParam(req, "id", uuid.New().String())

		err := app.DeleteContact(req)
		require.NoError(t, err)
		assert.Equal(t, fasthttp.StatusNotFound, testutil.GetResponseStatusCode(req))
	})
}

// --- Helper function tests ---

func TestApp_buildContactResponse(t *testing.T) {
	t.Parallel()

	t.Run("builds contact response correctly", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		response := app.buildContactResponse(contact, org.ID)

		assert.Equal(t, contact.ID, response.ID)
		assert.Equal(t, contact.PhoneNumber, response.PhoneNumber)
		assert.Equal(t, contact.ProfileName, response.ProfileName)
		assert.Equal(t, "pending", response.Status)
		assert.NotNil(t, response.Tags)
	})

	t.Run("resolves assigned user name", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithFullName("John Doe"))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Update("assigned_user_id", user.ID).Error)

		response := app.buildContactResponse(contact, org.ID)

		assert.Equal(t, user.ID, *response.AssignedUserID)
		assert.Equal(t, "John Doe", response.AssignedUserName)
	})
}

func TestApp_resolveAssignedUserName(t *testing.T) {
	t.Parallel()

	t.Run("returns empty string for nil contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)

		name := app.resolveAssignedUserName(nil, org.ID)
		assert.Empty(t, name)
	})

	t.Run("returns empty string for unassigned contact", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		name := app.resolveAssignedUserName(contact, org.ID)
		assert.Empty(t, name)
	})

	t.Run("resolves name from preloaded AssignedUser", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
		user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithFullName("Jane Doe"))
		contact := testutil.CreateTestContact(t, app.DB, org.ID)

		require.NoError(t, app.DB.Model(contact).Update("assigned_user_id", user.ID).Error)
		require.NoError(t, app.DB.Preload("AssignedUser").Where("id = ?", contact.ID).First(&contact).Error)

		name := app.resolveAssignedUserName(contact, org.ID)
		assert.Equal(t, "Jane Doe", name)
	})
}

func TestApp_broadcastContactLifecycleUpdate(t *testing.T) {
	t.Parallel()

	t.Run("does not panic with nil WSHub", func(t *testing.T) {
		app := newTestApp(t)
		org := testutil.CreateTestOrganization(t, app.DB)
