}

// TestApp_getChatbotFlowByIDCached_Success tests retrieving a specific flow by ID
func TestApp_getChatbotFlowByIDCached_Success(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	flow1 := testutil.CreateTestChatbotFlow(t, app.DB, org.ID, "test-account")
	flow2 := testutil.CreateTestChatbotFlow(t, app.DB, org.ID, "test-account")

	// Retrieve first flow
	result, err := app.GetChatbotFlowByIDCached(org.ID, flow1.ID)
	require.NoError(t, err)
	assert.Equal(t, flow1.ID, result.ID)
	assert.Equal(t, flow1.Name, result.Name)

	// Retrieve second flow
	result, err = app.GetChatbotFlowByIDCached(org.ID, flow2.ID)
	require.NoError(t, err)
	assert.Equal(t, flow2.ID, result.ID)
}

