// TestApp_getUserPermissionsCached_CacheHit tests retrieving user permissions from cache
func TestApp_getUserPermissionsCached_CacheHit(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	// Create user with role
	role := testutil.CreateTestRoleWithKeys(t, app.DB, org.ID, "test-role", []string{"users:read", "users:write"})
	user := testutil.CreateTestUser(t, app.DB, org.ID, testutil.WithRoleID(&role.ID))

	perms := &UserPermissions{
		RoleID:       role.ID,
		RoleName:     role.Name,
		IsSystem:     role.IsSystem,
		IsSuperAdmin: false,
		Permissions:  []string{"users:read", "users:write"},
	}

	// Manually cache
	cacheKey := "permissions:user:" + user.ID.String()
	data, err := json.Marshal(perms)
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), cacheKey, data, 6*time.Hour).Err()
	require.NoError(t, err)

	// Retrieve from cache
	result, err := app.GetUserPermissionsCached(user.ID)
	require.NoError(t, err)
	assert.Equal(t, role.ID, result.RoleID)
	assert.Len(t, result.Permissions, 2)
}

