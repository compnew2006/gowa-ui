// TestApp_getUserPermissionsCached_WithOrgID tests retrieving permissions with org ID
func TestApp_getUserPermissionsCached_WithOrgID(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org1 := testutil.CreateTestOrganization(t, app.DB)
	org2 := testutil.CreateTestOrganization(t, app.DB)

	// Create roles for each org
	role1 := testutil.CreateTestRoleWithKeys(t, app.DB, org1.ID, "role1", []string{"users:read"})
	role2 := testutil.CreateTestRoleWithKeys(t, app.DB, org2.ID, "role2", []string{"users:write"})

	// Create user
	user := testutil.CreateTestUser(t, app.DB, org1.ID, testutil.WithRoleID(&role1.ID))

	// Add user to org2 with different role
	userOrg := &models.UserOrganization{
		UserID:         user.ID,
		OrganizationID: org2.ID,
		RoleID:         &role2.ID,
	}
	require.NoError(t, app.DB.Create(userOrg).Error)

	// Get permissions for org1 (default role)
	result1, err := app.GetUserPermissionsCached(user.ID, org1.ID)
	require.NoError(t, err)
	assert.Equal(t, role1.ID, result1.RoleID)

	// Get permissions for org2 (org-specific role)
	result2, err := app.GetUserPermissionsCached(user.ID, org2.ID)
	require.NoError(t, err)
	assert.Equal(t, role2.ID, result2.RoleID)
}

