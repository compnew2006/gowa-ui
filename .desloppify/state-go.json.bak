      "id": "review::.::holistic::contract_coherence::jsonb-runtime-type-gap",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "JSONB field access via type assertions creates gap between stated model and runtime behavior",
      "detail": {
        "holistic": true,
