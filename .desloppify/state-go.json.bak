    "review::.::holistic::cross_module_architecture::pkg_imports_internal": {
      "id": "review::.::holistic::cross_module_architecture::pkg_imports_internal",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "pkg/whatsmeow and pkg/whatsapp import internal/ packages, inverting the intended dependency direction",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "pkg/whatsmeow/manager.go",
          "pkg/whatsmeow/events.go",
          "pkg/whatsmeow/message_persist.go",
          "pkg/whatsmeow/inbound_media_recovery.go",
          "pkg/whatsmeow/media_service.go",
          "pkg/whatsapp/adapter.go"
        ],
        "evidence": [
          "pkg/whatsmeow/manager.go imports internal/config, internal/models, internal/queue, internal/websocket (lines 11-14)",
          "pkg/whatsmeow/events.go imports internal/campaignstats, internal/models, internal/websocket (lines 8-10)",
          "pkg/whatsapp/adapter.go imports internal/models (line 7)",
          "Across the whatsmeow package, 80+ import lines reference internal/ packages spanning models, queue, websocket, config, storage, and campaignstats"
        ],
        "suggestion": "Move shared types (models, queue job types, websocket message types) to a new internal/domain or pkg/types package that both pkg/ and internal/ can depend on. Alternatively, accept that pkg/whatsmeow is tightly coupled and move it into internal/whatsmeow to make the coupling honest.",
