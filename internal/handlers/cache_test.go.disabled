	org := testutil.CreateTestOrganization(t, app.DB)

	// Create tags
	tag1 := testutil.CreateTestTag(t, app.DB, org.ID, "zebra")
	tag2 := testutil.CreateTestTag(t, app.DB, org.ID, "apple")

	// Retrieve from DB (should be ordered by name)
	result, err := app.GetTagsCached(org.ID)
	require.NoError(t, err)
	assert.Len(t, result, 2)
	assert.Equal(t, "apple", result[0].Name) // Alphabetically first
	assert.Equal(t, "zebra", result[1].Name)
}

// TestApp_InvalidateChatbotSettingsCache tests invalidating settings cache
func TestApp_InvalidateChatbotSettingsCache(t *testing.T) {
	t.Parallel()

	app := newTestApp(t)
	org := testutil.CreateTestOrganization(t, app.DB)

	// Create cache entries
	cacheKey1 := "chatbot:settings:" + org.ID.String() + ":account1"
	cacheKey2 := "chatbot:settings:" + org.ID.String() + ":account2"

	err := app.Redis.Set(context.Background(), cacheKey1, "data1", 6*time.Hour).Err()
	require.NoError(t, err)
	err = app.Redis.Set(context.Background(), cacheKey2, "data2", 6*time.Hour).Err()
	require.NoError(t, err)

	// Invalidate
	app.InvalidateChatbotSettingsCache(org.ID)

	// Verify keys are deleted
	_, err = app.Redis.Get(context.Background(), cacheKey1).Result()
	assert.Equal(t, redis.Nil, err)

	_, err = app.Redis.Get(context.Background(), cacheKey2).Result()
	assert.Equal(t, redis.Nil, err)
}

